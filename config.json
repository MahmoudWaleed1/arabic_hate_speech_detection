{
  "model_name": "UBC-NLP/MARBERT",
  "num_labels": 2,
  "max_length": 128,
  "batch_size": 12,
  "learning_rate": 1e-5,
  "num_epochs": 5,
  "warmup_steps": 80,
  "weight_decay": 0.01,
  "dataset_name": "manueltonneau/arabic-hate-speech-superset",
  "train_split": "train",
  "test_split": "test",
  "validation_split": 0.1,
  "save_steps": 500,
  "eval_steps": 500,
  "logging_steps": 100,
  "early_stopping_patience": 3,
  "device": "auto",
  "force_cpu": false,
  "mixed_precision": true,
  "dataloader_pin_memory": true,
  "seed": 42,
  "loss_function": "focal",
  "focal_alpha": 0.8,
  "focal_gamma": 3,
  "use_sampler": true,
  "threshold": 0.45
}
